# Copy to .env.local and fill in. Both VITE_ values end up in the JavaScript
# bundle, so only ever put publishable values here.
#
# Never add the service_role key. It bypasses row level security completely,
# and Vite would inline it into a file any visitor can read.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# Optional. Used for canonical links, Open Graph URLs and the generated
# sitemap. Defaults to the production deployment when unset.
# VITE_SITE_URL=https://alpenglow-retreat.vercel.app
